cc_binary(
  name = "diff",
  srcs = [
      "analyze.c",
      "context.c",
      "diff.c",
      "dir.c",
      "ed.c",
      "ifdef.c",
      "io.c",
      "normal.c",
      "paths.h",
      "side.c",
      "system.c",
      "util.c"
  ] + [
      "diff.h",
      "system.h",
  ],
  deps = [
      "//lib:diffutils",
      ":ver",
  ],
  includes = ["../lib"],
)

cc_library(
    name = "ver",
    srcs = ["version.c", "version.h"],
    hdrs = ["version.h"],
    deps = ["//lib:diffutils"],
    includes = [".", "../lib"],
)
