[
    genrule(
        name = hdr[:-len(".h")] + "_h",
        srcs = [template] + select({
            "@platforms//os:macos": [],
            "//conditions:default": LINUX_INLINE_VARS.values(),
        }),
        outs = [hdr],
        # cmd = select({
        #     "@platforms//os:macos": sed_command(
        #         automake_vars = MACOS_AUTOMAKE_VARS,
        #         delete_vars = MACOS_DELETE_VARS,
        #         direct_vars = MACOS_DIRECT_VARS,
        #         inline_vars = MACOS_INLINE_VARS,
        #         sed = "@sed",
        #         template = template,
        #         use_direct_vars = True if hdr in USES_DIRECT_REPLACEMENTS else False,
        #     ),
        #     "//conditions:default": sed_command(
        #         automake_vars = LINUX_AUTOMAKE_VARS,
        #         delete_vars = LINUX_DELETE_VARS,
        #         direct_vars = LINUX_DIRECT_VARS,
        #         inline_vars = LINUX_INLINE_VARS,
        #         sed = "@sed",
        #         template = template,
        #         use_direct_vars = True if hdr in USES_DIRECT_REPLACEMENTS else False,
        #     ),
        # }),
        cmd = sed_command(
            automake_vars = LINUX_AUTOMAKE_VARS,
            delete_vars = LINUX_DELETE_VARS,
            direct_vars = LINUX_DIRECT_VARS,
            inline_vars = LINUX_INLINE_VARS,
            sed = "@sed",
            template = template,
            use_direct_vars = False,
        ),
        # cmd_bat = select({
        #     "@platforms//os:macos": sed_command(
        #         automake_vars = MACOS_AUTOMAKE_VARS,
        #         delete_vars = MACOS_DELETE_VARS,
        #         direct_vars = MACOS_DIRECT_VARS,
        #         inline_vars = MACOS_INLINE_VARS,
        #         is_windows = True,
        #         sed = "@sed",
        #         template = template,
        #         use_direct_vars = True if hdr in USES_DIRECT_REPLACEMENTS else False,
        #     ),
        #     "//conditions:default": sed_command(
        #         automake_vars = LINUX_AUTOMAKE_VARS,
        #         delete_vars = LINUX_DELETE_VARS,
        #         direct_vars = LINUX_DIRECT_VARS,
        #         inline_vars = LINUX_INLINE_VARS,
        #         is_windows = True,
        #         sed = "@sed",
        #         template = template,
        #         use_direct_vars = True if hdr in USES_DIRECT_REPLACEMENTS else False,
        #     ),
        # }),
        tools = ["@sed"],
    )
    for hdr, template in BUILT_SOURCES.items()
]


cc_library(
    name = "diffutils",
    # srcs = BUILT_SOURCES + libdiffutils_a_SOURCES +
    srcs = libdiffutils_a_SOURCES +
    glob(["**/*.h"], ["**/*.in.h"]) +
    BUILT_SOURCES.keys(),
    deps = [
        ":diffutils_a-fopen",
        ":diffutils_a-mbsrtoc32s-state",
        ":diffutils_a-mbsrtowcs-state",
        ":diffutils_a-mktime",
    ],
    textual_hdrs = ["xstrtol.c", "strftime.c"],
    includes = ["."],
    visibility = ["//src:__subpackages__"]
)

cc_library(
    name = "diffutils_a-fopen",
    srcs = [
        "fopen.c",
        "config.h",
        "stdio.h",
        "fcntl.h",
        # "unistd.h",
        # "sys/types.h",
        # "sys/stat.h",
    ],
    includes = ["."]
)

cc_library(
    name = "diffutils_a-mbsrtoc32s-state",
    srcs = [
        "mbsrtoc32s-state.c",
        "config.h",
    ],
    includes = ["."]
)

cc_library(
    name = "diffutils_a-mbsrtowcs-state",
    srcs = [
        "mbsrtowcs-state.c",
        "config.h",
    ],
    includes = ["."]
)

cc_library(
    name = "diffutils_a-mktime",
    srcs = [
        "mktime.c",
        "config.h",
        "libc-config.h",
        "stdckdint.h",
        "intprops.h",
        "intprops-internal.h",
        "mktime-internal.h",
    ],
    includes = ["."]
)

copy_file(
    name = "config_h",
    src = select({
        "@platforms//os:macos": "config_macos.h",
        "//conditions:default": "config_linux.h",
    }),
    out = "config.h",
    # tags = ["manual"],
)
