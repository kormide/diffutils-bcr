USES_DIRECT_REPLACEMENTS = [
    "assert.h",
    "malloc/dynarray-skeleton.gl.h"
]

[
    genrule(
        name = hdr[:-len(".h")] + "_h",
        srcs = [template] + select({
            "@platforms//os:macos": MACOS_INLINE_VARS.values(),
            "//conditions:default": LINUX_INLINE_VARS.values(),
        }),
        outs = [hdr],
        cmd = select({
            "@platforms//os:osx": sed_command(
                automake_vars = MACOS_AUTOMAKE_VARS,
                delete_vars = MACOS_DELETE_VARS,
                direct_vars = MACOS_DIRECT_VARS,
                inline_vars = MACOS_INLINE_VARS,
                sed = "@sed",
                template = template,
                delete_between = MACOS_DELETE_BETWEEN_PATTERNS,
                # use_direct_vars = False
                use_direct_vars = True if hdr in USES_DIRECT_REPLACEMENTS else False,
            ),
            "//conditions:default": sed_command(
                automake_vars = LINUX_AUTOMAKE_VARS,
                delete_vars = LINUX_DELETE_VARS,
                direct_vars = LINUX_DIRECT_VARS,
                inline_vars = LINUX_INLINE_VARS,
                sed = "@sed",
                template = template,
                delete_between = LINUX_DELETE_BETWEEN_PATTERNS,
                use_direct_vars = False
                # use_direct_vars = True if hdr in USES_DIRECT_REPLACEMENTS else False,
            ),
        }),

        # cmd_bat = select({
        #     "@platforms//os:macos": sed_command(
        #         automake_vars = MACOS_AUTOMAKE_VARS,
        #         delete_vars = MACOS_DELETE_VARS,
        #         direct_vars = MACOS_DIRECT_VARS,
        #         inline_vars = MACOS_INLINE_VARS,
        #         is_windows = True,
        #         sed = "@sed",
        #         template = template,
        #         use_direct_vars = True if hdr in USES_DIRECT_REPLACEMENTS else False,
        #     ),
        #     "//conditions:default": sed_command(
        #         automake_vars = LINUX_AUTOMAKE_VARS,
        #         delete_vars = LINUX_DELETE_VARS,
        #         direct_vars = LINUX_DIRECT_VARS,
        #         inline_vars = LINUX_INLINE_VARS,
        #         is_windows = True,
        #         sed = "@sed",
        #         template = template,
        #         use_direct_vars = True if hdr in USES_DIRECT_REPLACEMENTS else False,
        #     ),
        # }),
        tools = ["@sed"],
        tags = ["manual"],
    )
    for hdr, template in GENERATED_HEADERS.items()
]


cc_library(
    name = "diffutils",
    srcs = SOURCES +
    glob(["**/*.h"], ["**/*.in.h"]) +
    select({
        "@platforms//os:macos": MACOS_GENERATED_HEADERS,
        "//conditions:default": LINUX_GENERATED_HEADERS
    }),
    deps = [
        ":diffutils_a-fopen",
        ":diffutils_a-mbsrtoc32s-state",
        ":diffutils_a-mktime",
    ] + select({
        "@platforms//os:macos": [
            ":diffutils_a-fnmatch",
        ],
        "//conditions:default": [
            ":diffutils_a-mbsrtowcs-state",
        ]
    }),

    textual_hdrs = ["xstrtol.c", "strftime.c"] + select({
        "@platforms//os:macos": [
            "regex_internal.c",
            "strtol.c",
            "regcomp.c",
            "regexec.c",
            "malloc/dynarray-skeleton.c",
        ],
        "//conditions:default": []
    }),
    includes = ["."],
    visibility = ["//src:__subpackages__"]
)

